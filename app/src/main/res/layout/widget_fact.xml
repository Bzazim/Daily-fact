<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_dark"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/w_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_bulb" />

        <TextView
            android:id="@+id/w_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/did_you_know"
            android:textColor="#8FD3E8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_chip_dark"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:text="@string/sample_category"
            android:textColor="#CDEBF4"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="serif"
        android:gravity="start|top"
        android:lineSpacingMultiplier="1.2"
        android:maxLines="6"
        android:text="@string/sample_fact"
        android:textColor="#FFFFFF"
        android:textDirection="rtl"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/w_next"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_btn_dark"
            android:contentDescription="@string/next_fact"
            android:padding="8dp"
            android:src="@drawable/ic_next" />

        <ImageView
            android:id="@+id/w_favorite"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_btn_dark"
            android:contentDescription="@string/save_favorite"
            android:padding="8dp"
            android:src="@drawable/ic_heart" />
    </LinearLayout>
</LinearLayout>
